<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:layout_margin="16dp"
    tools:context=".TaskDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TitleTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_name_title"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/task_name_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:hint="@string/task_name_hint"
            android:inputType="text"
            android:minHeight="48dp"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:textColorHint="@color/light_gray"
            android:textColor="@color/white" />

        <TextView
            style="@style/TitleTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/duration_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pomodoro_title" />

                <EditText
                    android:id="@+id/pomodoro_duration_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:text="25"
                    android:background="@drawable/edit_text_background"
                    android:padding="12dp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/short_break_title" />

                <EditText
                    android:id="@+id/short_break_duration_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:text="5"
                    android:background="@drawable/edit_text_background"
                    android:padding="12dp"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/long_break_title" />

                <EditText
                    android:id="@+id/long_break_duration_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:text="15"
                    android:background="@drawable/edit_text_background"
                    android:padding="12dp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cycles_title" />

                <EditText
                    android:id="@+id/cycles_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:text="4"
                    android:background="@drawable/edit_text_background"
                    android:padding="12dp"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TitleTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alarm_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                style="@style/FieldTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pomodoro_title" />

            <Spinner
                android:id="@+id/pomodoro_alarm_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                style="@style/CustomSpinnerStyle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                style="@style/FieldTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/short_break_title" />

            <Spinner
                android:id="@+id/short_break_alarm_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                style="@style/CustomSpinnerStyle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                style="@style/FieldTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/long_break_title" />

            <Spinner
                android:id="@+id/long_break_alarm_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                style="@style/CustomSpinnerStyle" />
        </LinearLayout>

        <TextView
            style="@style/TitleTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/background_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                style="@style/FieldTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pomodoro_title" />

            <Spinner
                android:id="@+id/pomodoro_background_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                style="@style/CustomSpinnerStyle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                style="@style/FieldTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/short_break_title" />

            <Spinner
                android:id="@+id/short_break_background_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                style="@style/CustomSpinnerStyle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                style="@style/FieldTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/long_break_title" />

            <Spinner
                android:id="@+id/long_break_background_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                style="@style/CustomSpinnerStyle" />
        </LinearLayout>

        <TextView
            style="@style/TitleTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/task_color" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="6"
            android:rowCount="5"
            android:useDefaultMargins="true">

            <View
                android:id="@+id/color_1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_1" />

            <View
                android:id="@+id/color_2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_2" />

            <View
                android:id="@+id/color_3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_3" />

            <View
                android:id="@+id/color_4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_4" />

            <View
                android:id="@+id/color_5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_5" />

            <View
                android:id="@+id/color_6"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_6" />

            <View
                android:id="@+id/color_7"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_7" />

            <View
                android:id="@+id/color_8"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_8" />

            <View
                android:id="@+id/color_9"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_9" />

            <View
                android:id="@+id/color_10"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_10" />

            <View
                android:id="@+id/color_11"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_11" />

            <View
                android:id="@+id/color_12"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_12" />

            <View
                android:id="@+id/color_13"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_13" />

            <View
                android:id="@+id/color_14"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_14" />

            <View
                android:id="@+id/color_15"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_15" />

            <View
                android:id="@+id/color_16"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_16" />

            <View
                android:id="@+id/color_17"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_17" />

            <View
                android:id="@+id/color_18"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_18" />

            <View
                android:id="@+id/color_19"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_19" />

            <View
                android:id="@+id/color_20"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_20" />

            <View
                android:id="@+id/color_21"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_21" />

            <View
                android:id="@+id/color_22"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_22" />

            <View
                android:id="@+id/color_23"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_23" />

            <View
                android:id="@+id/color_24"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_24" />

            <View
                android:id="@+id/color_25"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_25" />

            <View
                android:id="@+id/color_26"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_26" />

            <View
                android:id="@+id/color_27"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_27" />

            <View
                android:id="@+id/color_28"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_28" />

            <View
                android:id="@+id/color_29"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_29" />

            <View
                android:id="@+id/color_30"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/color_swatch_circle"
                android:backgroundTint="@color/task_color_30" />
        </GridLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                style="?android:attr/buttonBarButtonStyle"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                style="?android:attr/buttonBarButtonStyle"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
